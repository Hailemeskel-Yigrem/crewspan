# RelayOps Environment Configuration
# Copy to .env and adjust for your environment

RELAYOPS_ENVIRONMENT=development
RELAYOPS_DEBUG=false

# Database
RELAYOPS_DATABASE_URL=postgresql+asyncpg://relayops:relayops@localhost:5432/relayops

# Redis
RELAYOPS_REDIS_URL=redis://localhost:6379/0
RELAYOPS_CELERY_BROKER_URL=redis://localhost:6379/1
RELAYOPS_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
RELAYOPS_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# API
RELAYOPS_CORS_ORIGINS=["http://localhost:3000"]
RELAYOPS_ACCESS_TOKEN_EXPIRE_MINUTES=60
RELAYOPS_LOG_LEVEL=INFO
RELAYOPS_LOG_JSON=true
